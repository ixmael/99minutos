meta {
  name: Create a new user
  type: http
  seq: 1
}

post {
  url: {{host}}/account
  body: json
  auth: inherit
}

body:json {
  {
    "email": "hola2@ixmael.dev",
    "password": "12345678"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: success example
  
  request: {
    url: {{host}}/account
    method: POST
    mode: json
    body:json: {
      {
        "email": "hola@ixmael.dev",
        "password": "12345678",
        "is_admin": true
      }
    }
  }
  
  response: {
    headers: {
      date: Wed, 18 Feb 2026 19:39:14 GMT
      content-length: 9
      content-type: text/plain; charset=utf-8
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 1
        }
      '''
    }
  }
}
